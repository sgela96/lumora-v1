# Copy to .env (or set in your hosting provider) — every value is optional in development.

# Public URL of this server. Used in the install snippet and in attachment links sent to ticket systems.
LUMORA_PUBLIC_URL=http://localhost:3000
PORT=3000

# Required in production: encrypts integration credentials and signs attachment links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMORA_SECRET=

# Where the SQLite database and uploads live (default: ./data)
LUMORA_DATA_DIR=
LUMORA_MAX_UPLOAD_MB=100
LUMORA_TRIAL_DAYS=14

# Stripe billing (monthly subscriptions). Without STRIPE_SECRET_KEY plans can be switched freely (demo mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# E-mail destination (any SMTP server), e.g. smtps://user:pass@smtp.example.com
SMTP_URL=
SMTP_FROM=Lumora <reports@lumora.app>

# AI-written steps & summaries (Business plan)
ANTHROPIC_API_KEY=
LUMORA_AI_MODEL=claude-opus-5-5

# Support Center: how often linked tickets are re-checked (seconds, 0 disables polling)
LUMORA_SYNC_INTERVAL_SEC=120
