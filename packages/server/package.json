{
  "name": "@lumora/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@lumora/shared": "0.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
